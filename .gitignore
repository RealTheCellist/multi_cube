yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Transient checkpoint files for long-running benchmark drivers (resume
# state for background runs that may be interrupted) -- never a Sprint
# deliverable, deleted automatically on successful completion.
**/data/checkpoint-*.json

# Raw large-state datasets (e.g. full Cubie[] dumps) generated by a Sprint
# and kept on disk for follow-up phases to consume -- IS a real Sprint
# artifact (unlike a checkpoint), just too large/reproducible-on-demand to
# commit to git. NOT deleted automatically.
**/data/raw-dataset-*.json

